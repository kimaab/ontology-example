hrd:Rule_WorkRules_Art22 a owl:NamedIndividual,
        hr:Regulation ;
    rdfs:label "취업규칙 제22조"@ko .

hrd:Rule_WorkRules_Art23 a owl:NamedIndividual,
        hr:Regulation ;
    rdfs:label "취업규칙 제23조"@ko .

hrd:Rule_WorkRules_Art24 a owl:NamedIndividual,
        hr:Regulation ;
    rdfs:label "취업규칙 제24조"@ko .

hr:Document a owl:Class ;
    rdfs:label "서류"@ko ;
    rdfs:comment "혜택 신청 시 제출하는 증빙서류. 예: 청첩장, 가족관계증명서, 진단서, 수료증"@ko .

hr:PaymentMethod a owl:Class ;
    rdfs:label "지급 방식"@ko ;
    rdfs:comment "혜택을 받는 방식. 예: 신청지급(직원이 신청해야 받음), 자동지급(신청 없이 받음)"@ko .

hr:ApplicationProcedure a owl:Class ;
    rdfs:label "신청 절차"@ko ;
    rdfs:comment "혜택을 신청하는 전체 절차. 여러 절차 단계로 이루어진다. 예: 휴가 신청 절차"@ko .

hr:BenefitType a owl:Class ;
    rdfs:label "혜택 종류"@ko ;
    rdfs:comment "복지혜택을 묶는 분류. 예: 휴가, 지원금, 교육지원"@ko .

hr:ProcedureStep a owl:Class ;
    rdfs:label "절차 단계"@ko ;
    rdfs:comment "신청 절차를 이루는 한 단계. 순서를 가진다. 예: 1단계 그룹웨어에서 휴가 종류 선택, 2단계 결재 상신"@ko .

hr:FamilyEvent a owl:Class ;
    rdfs:label "경조사"@ko ;
    rdfs:comment "혜택이 주어지는 직원 본인 또는 가족의 경사와 조사. 예: 결혼, 출산, 사망"@ko .

hrd:G1 a owl:NamedIndividual,
        hr:Grade ;
    rdfs:label "1급"@ko .

hrd:G2 a owl:NamedIndividual,
        hr:Grade ;
    rdfs:label "2급"@ko .

hrd:G3 a owl:NamedIndividual,
        hr:Grade ;
    rdfs:label "3급"@ko .

hrd:G4 a owl:NamedIndividual,
        hr:Grade ;
    rdfs:label "4급"@ko .

hrd:G5 a owl:NamedIndividual,
        hr:Grade ;
    rdfs:label "5급"@ko .

hrd:G6 a owl:NamedIndividual,
        hr:Grade ;
    rdfs:label "6급"@ko .

hrd:Leave a owl:NamedIndividual,
        hr:BenefitType ;
    rdfs:label "휴가"@ko .

hr:Grade a owl:Class ;
    rdfs:label "직급"@ko ;
    rdfs:comment "직원의 등급. 예: 1급 ~ 6급. 1급이 가장 높다."@ko .

hr:WelfareBenefit a owl:Class ;
    rdfs:label "복지혜택"@ko ;
    rdfs:comment "회사가 직원에게 주는 개별 혜택. 예: 연차휴가, 경조사휴가, 병가, 결혼축하금, 생일 축하금, 외부교육비 지원"@ko .

hrd:LV01 a owl:NamedIndividual,
        hr:WelfareBenefit ;
    rdfs:label "연차휴가"@ko ;
    hr:hasBenefitType hrd:Leave .

hrd:Rule_WorkRules_Art20 a owl:NamedIndividual,
        hr:Regulation ;
    rdfs:label "취업규칙 제20조"@ko .

hr:Regulation a owl:Class ;
    rdfs:label "근거 규정"@ko ;
    rdfs:comment "부여 조건의 근거가 되는 규정 조항. 예: 취업규칙 제20조, 복리후생규정 별표 1, 근로기준법 제60조"@ko .

hr:GrantCondition a owl:Class ;
    rdfs:label "부여 조건"@ko ;
    rdfs:comment "어떤 조건(근속, 직급, 경조사)에서 어떤 혜택을 얼마나 주는지 묶은 규칙. 예: 근속 3년 이상 5년 미만이면 연차휴가 16일"@ko .

hr:Employee a owl:Class ;
    rdfs:label "직원"@ko ;
    rdfs:comment "회사에 고용된 사람. 입사일과 직급에 따라 받을 수 있는 복지혜택이 달라진다."@ko .

