        hr:WelfareBenefit ;
    rdfs:label "경조사휴가"@ko ;
    hr:hasBenefitType hrd:Leave .

hrd:LV04 a owl:NamedIndividual,
        hr:WelfareBenefit ;
    rdfs:label "병가"@ko ;
    hr:hasBenefitType hrd:Leave .

hrd:LV05 a owl:NamedIndividual,
        hr:WelfareBenefit ;
    rdfs:label "공가"@ko ;
    hr:hasBenefitType hrd:Leave .

hrd:LV06 a owl:NamedIndividual,
        hr:WelfareBenefit ;
    rdfs:label "무급휴가"@ko ;
